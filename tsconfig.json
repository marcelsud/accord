{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": ".test-build",
    "types": [
      "node"
    ],
    "paths": {
      "@marcelsud/accord": [
        "./src/index.ts"
      ],
      "@marcelsud/accord/effect": [
        "./src/effect.ts"
      ],
      "@marcelsud/accord/sqlite": [
        "./src/sqlite.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
